# Copia este fichero a .env y ajusta los valores.
#   cp .env.example .env
#
# .env esta excluido en .gitignore. Las contrasenas NO van aqui:
# se pasan como Docker secrets (ver README).

# ─── Obligatorio ───────────────────────────────────────────────────────
# Sin estos dos valores el contenedor se detiene al arrancar.
SOURCE_USER=usuario@juntadeandalucia.es
DEST_USER=usuario@g.educaand.es

# ─── Buzon de origen ───────────────────────────────────────────────────
SOURCE_HOST=imap.juntadeandalucia.es
SOURCE_PORT=993

# ─── Buzon de destino ──────────────────────────────────────────────────
DEST_HOST=imap.gmail.com
DEST_PORT=993
# Activa las optimizaciones de imapsync para Gmail. Ponlo a false si el
# destino no es Gmail.
DEST_IS_GMAIL=true

# ─── Sincronizacion ────────────────────────────────────────────────────
# Carpeta a sincronizar en origen.
SYNC_FOLDER=INBOX
# Solo se sincroniza el correo de los ultimos N dias.
MAX_AGE=7
# Segundos entre ciclos (minimo 60).
SLEEP_INTERVAL=600

# true = mover (borra en origen lo ya transferido). false = copiar.
DELETE_SOURCE=true

# true = simulacion, no escribe ni borra nada. Recomendado en la primera
# puesta en marcha para comprobar el filtrado sin tocar el buzon real.
DRY_RUN=false

# ─── Filtrado de publicidad ────────────────────────────────────────────
# El correo cuyo asunto contenga SPAM_SUBJECT se envia a SPAM_FOLDER en una
# segunda pasada. Deja SPAM_SUBJECT vacio para desactivarla.
SPAM_SUBJECT=Publicidad
SPAM_FOLDER=[Gmail]/Spam

# ─── Logs ──────────────────────────────────────────────────────────────
LOG_DIR=/var/log/imapsync
# Tamano a partir del cual se rota y comprime (100 MB).
LOG_MAX_BYTES=104857600
# Numero de ficheros comprimidos que se conservan.
LOG_KEEP=3

# ─── Tolerancia a fallos ───────────────────────────────────────────────
# Segundos maximos por pasada; al superarlos se aborta y el ciclo continua.
PASS_TIMEOUT=480
# Margen antes de enviar SIGKILL si no atiende al SIGTERM.
PASS_KILL_AFTER=30

# ─── Avanzado ──────────────────────────────────────────────────────────
# Rutas de los Docker secrets. Solo cambian si renombras los secretos en
# docker-compose.yml.
#SOURCE_PASSFILE=/run/secrets/password_corporativo_junta
#DEST_PASSFILE=/run/secrets/password_geducaand

# Usados por 'make test'; normalmente no hace falta tocarlos aqui.
#   RUN_ONCE=true  → un unico ciclo y termina, en vez de bucle infinito
#   VERBOSE=true   → vuelca ademas la salida de imapsync por pantalla
#RUN_ONCE=false
#VERBOSE=false
